{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "templates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "source"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "source": {
            "type": "object",
            "required": ["file", "nodeId"],
            "properties": {
              "file": { "type": "string" },
              "nodeId": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
