{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pen-antd.dev/schemas/prototype-plan.schema.json",
  "title": "Prototype plan",
  "description": "Module-level contract between input analysis and canvas generation. Produced before any Frame is created; `pen-antd plan validate` is the gate and `pen-antd doc build` is the only consumer.",
  "type": "object",
  "required": ["source", "modules"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "source": {
      "type": "string",
      "description": "The input the plan was derived from: requirement document, sketch, HTML or prompt summary."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["requirements", "markdown", "html", "pen", "prompt"] },
          "path": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Every assumption that changes the shape of the prototype."
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "goal", "structure"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "description": "Stable module key, e.g. `app-config.edit-drawer`."
          },
          "kind": {
            "enum": ["page", "drawer", "modal", "panel"],
            "description": "What the module is on the canvas. Decides the template category it may bind and the Frame name prefix."
          },
          "title": { "type": "string", "description": "Human name; becomes `Page ·`/`Drawer ·`/`Modal ·`/`Panel · <title>`." },
          "goal": { "type": "string", "description": "One sentence on what the user does inside this module." },
          "requirementRefs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Section numbers, feature ids or acceptance criteria this module implements."
          },
          "template": {
            "description": "Catalog pattern, board id or template name; or an outer/inner pair so the inner template lands in the outer template's replaceable slot.",
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["outer"],
                "additionalProperties": false,
                "properties": {
                  "outer": { "type": "string" },
                  "inner": { "type": "string" },
                  "slot": { "type": "string", "description": "Replaceable part of the outer template, by name or id." }
                }
              }
            ]
          },
          "structure": {
            "type": "array",
            "minItems": 1,
            "description": "Regions the module must contain, in visual order.",
            "items": {
              "type": "object",
              "required": ["role"],
              "additionalProperties": false,
              "properties": {
                "role": {
                  "enum": [
                    "shell",
                    "header",
                    "navigation",
                    "catalog",
                    "filters",
                    "list",
                    "table",
                    "form",
                    "detail",
                    "overlay",
                    "actions",
                    "footer",
                    "content",
                    "preview",
                    "feedback",
                    "custom"
                  ]
                },
                "label": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          },
          "components": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Library components the module instantiates; validated against the Kit registry."
          },
          "states": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Interaction states the module must represent, e.g. default/loading/empty/error/dirty/publishing."
          },
          "custom": { "type": "boolean", "description": "True when no catalog template covers the module." },
          "customReason": { "type": "string", "description": "Required when `custom` is true." },
          "notes": { "type": "string", "description": "Reuse or replacement notes recorded on the Frame." }
        }
      }
    }
  }
}
