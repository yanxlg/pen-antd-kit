{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/pen-antd/standards-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "standardsVersion", "status", "entrypoint", "qualityProfile", "runtimeDocuments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "standardsVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "status": { "enum": ["candidate", "passed"] },
    "entrypoint": { "type": "string", "minLength": 1 },
    "qualityProfile": { "type": "string", "minLength": 1 },
    "runtimeDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "appliesTo"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "appliesTo": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "provenanceDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
