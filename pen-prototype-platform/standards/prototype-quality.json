{
  "schemaVersion": 1,
  "requiredReviewDimensions": [
    "task-completeness",
    "component-provenance",
    "information-hierarchy",
    "state-completeness",
    "content-resilience",
    "desktop-canvas-compliance",
    "accessibility"
  ],
  "requiredPageStates": [
    "initial-loading",
    "data",
    "query-empty",
    "request-failure"
  ],
  "conditionalStates": [
    "editing",
    "validation-failure",
    "submitting",
    "success",
    "save-failure",
    "disabled",
    "unauthorized"
  ],
  "hardFailures": [
    "missing-primary-task",
    "required-template-not-instantiated",
    "content-component-not-instantiated",
    "hand-drawn-existing-library-component",
    "unreachable-full-value",
    "unmodeled-destructive-confirmation",
    "color-only-state",
    "clipped-primary-action",
    "unresolved-placeholder",
    "accidental-overlap",
    "narrow-screen-state",
    "invalid-desktop-resolution"
  ],
  "reviewViewports": [
    { "name": "desktop", "width": 1920, "minimumHeight": 1080 }
  ]
}
